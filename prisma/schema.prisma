  // Giorni dopo invio video: se non guardato, crea promemoria follow-up (default 7)
  followUpDaysVideo Int @default(7) @map("follow_up_days_video")

  // Mesi prima di ricontattare DA_RICHIAMARE_6M (default 6)
  recontactMonths Int @default(6) @map("recontact_months")

  // Ricerche Programmate
  scheduledSearchesPerRun Int @default(1) @map("scheduled_searches_per_run")
  scheduledSearchHour     Int @default(2) @map("scheduled_search_hour")
  scheduledLeadsPerSearch Int @default(50) @map("scheduled_leads_per_search")

  // AI Configuration
  aiProvider    String  @default("gemini") @map("ai_provider") // gemini | claude | openai
  aiModelGemini String? @map("ai_model_gemini") // es. gemini-2.5-flash
  aiModelClaude String? @map("ai_model_claude") // es. claude-sonnet-4-6
  aiModelOpenai String? @map("ai_model_openai") // es. gpt-4o

  // Prompt templates
  strategicAnalysisPrompt String? @map("strategic_analysis_prompt") @db.Text
  readingScriptPrompt     String? @map("reading_script_prompt") @db.Text
  analystPrompt           String? @map("analyst_prompt") @db.Text
  scriptwriterPrompt      String? @map("scriptwriter_prompt") @db.Text
  emailGenPrompt          String? @map("email_gen_prompt") @db.Text // Istruzioni AI per scrivere la mail 1 (opt-in)
  optInSubjects           String? @map("opt_in_subjects") @db.Text // Lista oggetti mail opt-in (uno per riga, a rotazione)

  // ==========================================
  // EMAIL & MESSAGGI
  // ==========================================
  // Mittente
  emailFromAddress String? @map("email_from_address") // default: env SMTP_FROM_OUTREACH
  emailFromName    String? @map("email_from_name") // default: env SMTP_FROM_NAME

  // Footer GDPR
  gdprCompanyName     String? @map("gdpr_company_name")
  gdprAddress         String? @map("gdpr_address")
  gdprVatNumber       String? @map("gdpr_vat_number") // P.IVA
  gdprFooterText      String? @map("gdpr_footer_text") @db.Text // "Hai ricevuto questa email..."
  gdprUnsubscribeText String? @map("gdpr_unsubscribe_text") // "Non desidero ricevere..."

  // Firma usata nelle mail di outreach opt-in
  signatureAlessio String? @map("signature_alessio") @db.Text

  // Outreach opt-in (mail 1: invita a compilare il questionario / self-assessment)
  sdLandingUrl       String? @map("sd_landing_url") // Landing Metodo SD (es. karalisweb.net/web-marketing)
  alessioLinkedinUrl String? @map("alessio_linkedin_url") // Profilo LinkedIn di Alessio (prova sociale)
  questionnaireUrl   String? @map("questionnaire_url") // Link self-assessment/questionario ({{QUESTIONARIO}}) — unico link della mail 1
  emailDailyCap      Int     @default(20) @map("email_daily_cap") // Quante aziende contattare via mail al giorno
  pausedSegments     String? @map("paused_segments") // Settori (segment key, separati da virgola) da NON contattare ora: esclusi da coda e mailer

  // Gate di approvazione: se true, la mail 1 NON parte in automatico → coda di approvazione (Alessio approva/ritocca)
  outreachRequireApproval  Boolean @default(true) @map("outreach_require_approval")
  // Soglia score per entrare nella coda di approvazione (sotto = lasciati da parte)
  outreachApprovalMinScore Int     @default(60) @map("outreach_approval_min_score")

  // Notifiche
  // Email destinatarie delle notifiche video views (separate da virgola)
  // es. "alessio@karalisweb.net,consulenza@karalisweb.net"
  notificationEmails String? @map("notification_emails") @db.Text

  // Calendario di Alessio (link segreto iCal): gli incontri BNI prenotati entrano da soli (v3.47)
  calendarIcsUrl    String?   @map("calendar_ics_url") @db.Text
  calendarSyncedAt  DateTime? @map("calendar_synced_at")
  calendarSyncError String?   @map("calendar_sync_error")
  calendarSyncInfo  String?   @map("calendar_sync_info")

  // Agenti dell'analisi: "auto" o "mano" per chiave (v3.49). Vuoto = il modo predefinito del catalogo.
  agentiModo Json @default("{}") @map("agenti_modo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ==========================================
// OPPORTUNITA' EXTRA-BNI (clienti caldi che arrivano da fuori)
// ==========================================
// Contatti/opportunita' che NON sono lead freddi (no scraping, no audit) e NON sono
// membri BNI: un collega per una collaborazione, un preventivo da lavorare, un referral
// che arriva da chiunque. Modello a se' per non inquinare le liste Hot/Warm/Cold.
// Il campo chiave e' nextFollowupAt: il promemoria che evita di dimenticarli.
model Opportunita {
  id String @id @default(uuid())

  name         String // Persona o azienda
  source       String  @default("altro") // collega | referral | evento | ex_cliente | bni | altro
  sourceDetail String? @map("source_detail") // Chi l'ha passato / dove l'ho conosciuto

  phone   String?
  email   String?
  website String?
  about   String? @db.Text // Di cosa si tratta

  stage          String @default("DA_SENTIRE") // DA_SENTIRE | IN_CORSO | PREVENTIVO | VINTO | PERSO
  estimatedValue Int?   @map("estimated_value") // Valore stimato in euro (opzionale)

  nextFollowupAt  DateTime? @map("next_followup_at") // Promemoria: quando risentirlo
  lastContactedAt DateTime? @map("last_contacted_at")

  notes      String?      @db.Text
  createdBy  String?      @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  trattative Trattativa[]

  @@index([stage], name: "idx_opportunita_stage")
  @@index([nextFollowupAt], name: "idx_opportunita_followup")
  @@map("opportunita")
}

// ==========================================
// REGISTRO UNICO DEI SOGGETTI — OrchestraAI Fase 1
// ==========================================
// Entità nuove, distinte dalla catena di tenancy (piano, sezione 3.2).
// Nessun modello preesistente è stato modificato.
//
// REGISTRO IN SOLA AGGIUNTA: in questa fase nessuna applicazione scrive su
// Subject. È alimentato esclusivamente dall'importazione in sola lettura
// (scripts/subject-registry/). Le anagrafiche di origine non vengono toccate.
//
// I campi di Subject sono volutamente MINIMI: la loro composizione definitiva
// è una decisione della sezione 8 del piano e non è stata presa.
// Vedi docs/decisions/OPEN-01.md.

model Subject {
  id String @id @default(uuid())

  // Etichetta leggibile. Non è una chiave: la ragione sociale non deduplica
  // (piano, sezione 3.2: "Nessuna deduplicazione automatica su ragione sociale").
  displayName String @map("display_name")

  // Chiave di deduplicazione 1 — priorità massima.
  googlePlaceId String? @unique @map("google_place_id")

  // Chiave di deduplicazione 2 — dominio normalizzato (minuscolo, senza
  // schema, senza "www.", senza porta, senza percorso, senza punto finale).
  primaryDomain String? @map("primary_domain")

  // Chiave di deduplicazione 3 — oggi SEMPRE null: nessuna delle sei
  // anagrafiche raccoglie la partita IVA. Colonna predisposta, non usata.
  // Vedi docs/decisions/OPEN-02.md.
  vatNumber String? @map("vat_number")

  countryCode String? @map("country_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Azienda che osserva questo soggetto. Nullable finche la migrazione dei
  // dati non e completata: renderla obbligatoria e un secondo passo, non
  // questo, perche una colonna NOT NULL su tabella popolata perde dati.
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  identities      SubjectIdentity[]
  leftCandidates  ReconciliationCandidate[] @relation("ReconLeft")
  rightCandidates ReconciliationCandidate[] @relation("ReconRight")

  @@index([companyId], name: "idx_subjects_company")
  @@index([primaryDomain], name: "idx_subjects_domain")
  @@index([displayName], name: "idx_subjects_name")
  @@map("subjects")
}

model SubjectIdentity {
  id String @id @default(uuid())

  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  source     SubjectSource
  externalId String        @map("external_id")

  // Fotografia dei campi di origine utili alla riconciliazione.
  // Non è una copia dell'anagrafica: non va usata come sorgente di verità.
  payload Json?

  // Quando questa identità è stata vista l'ultima volta dall'importazione.
  seenAt    DateTime @default(now()) @map("seen_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([source, externalId], name: "uq_identity_source_external")
  @@index([subjectId], name: "idx_identity_subject")
  @@index([source], name: "idx_identity_source")
  @@map("subject_identities")
}

// Coda di riconciliazione manuale (piano, sezione 3.2).
// Ci finisce ogni corrispondenza NON certa. Il codice non la risolve.
model ReconciliationCandidate {
  id String @id @default(uuid())

  leftSubjectId  String  @map("left_subject_id")
  leftSubject    Subject @relation("ReconLeft", fields: [leftSubjectId], references: [id], onDelete: Cascade)
  rightSubjectId String  @map("right_subject_id")
  rightSubject   Subject @relation("ReconRight", fields: [rightSubjectId], references: [id], onDelete: Cascade)

  // Perché è dubbio: "same_normalized_name", "shared_email_domain",
  // "domain_host_mismatch", "similar_name" ...
  reason   String
  score    Float?
  evidence Json?

  status    ReconciliationStatus @default(PENDING)
  decidedAt DateTime?            @map("decided_at")
  decidedBy String?              @map("decided_by")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([leftSubjectId, rightSubjectId], name: "uq_recon_pair")
  @@index([status], name: "idx_recon_status")
  @@map("reconciliation_candidates")
}

// I valori sono gli identificatori delle anagrafiche di origine, non termini
// di dominio: restano nella forma in cui le tabelle si chiamano davvero.
enum SubjectSource {
  crm_lead
  crm_opportunita
  crm_bnimembro
  gads_account
  seoi_client
  hub_project
}

enum ReconciliationStatus {
  PENDING
  MERGED
  REJECTED
}

// ==========================================
// TENANCY — OrchestraAI Fase 1
// ==========================================
// Catena della sezione 3.1 del piano:
//   Organization → Company → Project
// Additiva: nessun modello preesistente è stato modificato.
// Il livello Organization è invisibile in interfaccia quando ne esiste una sola
// (piano, sezione 3.1).

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]

  @@map("organizations")
}

model Company {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  vatNumber String?      @map("vat_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects     Project[]
  licence      Licence?
  subjects     Subject[]
  entitlements ModuleEntitlement[]

  @@index([organizationId], name: "idx_companies_org")
  @@map("companies")
}

model Project {
  id        String  @id @default(uuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name   String
  slug   String
  status TenantStatus @default(ACTIVE)

  // Conoscenza condivisa (piano, sezione 3.4): si scrive una volta sola e
  // ogni modulo attivo sul Progetto la legge. Nessun modulo ne possiede copia.
  valueProposition String? @map("value_proposition") @db.Text
  toneOfVoice      String? @map("tone_of_voice") @db.Text

  // Colonne presenti nel DB di produzione (lavoro del branch fase1, mai arrivato in main).
  // Il codice di main non le usa: stanno qui solo perché `prisma db push` non le cancelli.
  whatWeSell         String?   @map("what_we_sell") @db.Text
  targetAudience     String?   @map("target_audience") @db.Text
  differentiators    String?   @map("differentiators") @db.Text
  wordsToUse         String?   @map("words_to_use") @db.Text
  wordsToAvoid       String?   @map("words_to_avoid") @db.Text
  knowledgeBase      String?   @map("knowledge_base") @db.Text
  aiInstructions     String?   @map("ai_instructions") @db.Text
  websiteUrl         String?   @map("website_url")
  linkedProfiles     String?   @map("linked_profiles") @db.Text
  knowledgeUpdatedAt DateTime? @map("knowledge_updated_at")
  knowledgeUpdatedBy String?   @map("knowledge_updated_by")
  referenceContact   String?   @map("reference_contact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, slug], name: "uq_project_company_slug")
  @@index([companyId], name: "idx_projects_company")
  @@map("projects_core")
}

// Licenza per Company. Inclusi due Project e tre utenti, entrambi estendibili
// (piano, sezione 3.1). I limiti sono colonne, non costanti nel codice.
model Licence {
  id        String  @id @default(uuid())
  companyId String  @unique @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan        String       @default("standard")
  status      TenantStatus @default(ACTIVE)
  maxProjects Int          @default(2) @map("max_projects")
  maxUsers    Int          @default(3) @map("max_users")

  startsAt DateTime  @default(now()) @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("licences")
}

// Il permesso è sempre (ruolo, scope), mai ruolo da solo (piano, sezione 2).
model Membership {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      MembershipRole
  scopeType ScopeType      @map("scope_type")
  // null solo per lo scope GLOBAL: un PLATFORM_ADMIN non ha un ambito.
  scopeId   String?        @map("scope_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([userId, role, scopeType, scopeId], name: "uq_membership")
  @@index([userId], name: "idx_membership_user")
  @@index([scopeType, scopeId], name: "idx_membership_scope")
  @@map("memberships")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Le sette figure della sezione 2 del piano.
enum MembershipRole {
  PLATFORM_ADMIN // Alessio. Vede e amministra tutto.
  PLATFORM_OPERATOR // Team Karalisweb. Nessun accesso a fatturazione.
  ORG_OWNER // Titolare di più Aziende.
  COMPANY_OWNER // Cliente licenziatario.
  COMPANY_MEMBER // Utente del cliente, tutti i Progetti dell'Azienda.
  PROJECT_MEMBER // Un solo Progetto. Nessun dato commerciale.
  GUEST_LINK // Nessun account: magic link firmato e scadenzato.
}

enum ScopeType {
  GLOBAL
  ORGANIZATION
  COMPANY
  PROJECT
  RESOURCE
}

// Tabella presente nel DB di produzione (12 righe, lavoro del branch fase1).
// Il codice di main non la usa: sta qui solo perché `prisma db push` non la cancelli.
enum PlatformModule {
  ACQUISIZIONE
  CAMPAGNE
  VISIBILITA
  CONTENUTI
}

model ModuleEntitlement {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module      PlatformModule
  status      TenantStatus   @default(ACTIVE)
  activatedAt DateTime       @default(now()) @map("activated_at")
  activatedBy String?        @map("activated_by")
  suspendedAt DateTime?      @map("suspended_at")

  @@unique([companyId, module], name: "uq_entitlement_company_module")
  @@index([companyId], name: "idx_entitlements_company")
  @@map("module_entitlements")
}

// ==========================================
// SQUADRA DI AGENTI (v3.44) — vedi PROGETTO-AGENTI.md
// ==========================================
// Ogni agente lavora su un'azienda (Lead) e consegna un REFERTO con le prove.
// Il regista decide chi far lavorare; l'orologio (crontab) lo sveglia;
// quello che va deciso da Alessio finisce in CASSETTA. Niente parte da solo.

// Un lavoro: un agente su un'azienda. Sostituisce le code in memoria (p-queue):
// sopravvive ai riavvii e si ispeziona.
model AgentRun {
  id           String         @id @default(uuid())
  // Su cosa lavora: un'azienda, un capitolo BNI o un membro BNI (uno dei tre, o nessuno
  // per gli agenti che cercano aziende nuove come l'Esploratore).
  leadId       String?        @map("lead_id")
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bniChapterId String?        @map("bni_chapter_id")
  bniChapter   BniChapter?    @relation(fields: [bniChapterId], references: [id], onDelete: Cascade)
  bniMembroId  String?        @map("bni_membro_id")
  bniMembro    BniMembro?     @relation(fields: [bniMembroId], references: [id], onDelete: Cascade)
  agent        String // chiave del registro, es. "tecnico", "seo", "blog"
  status       AgentRunStatus @default(IN_CODA)
  attempts     Int            @default(0)
  error        String?
  costCents    Float          @default(0) @map("cost_cents") // costo esterno (API), in centesimi di euro (con decimali: una chiamata costa frazioni di centesimo)
  input        Json? // istruzioni del lavoro, se servono (es. la regione da mappare per il Cartografo)
  queuedAt     DateTime       @default(now()) @map("queued_at")
  startedAt    DateTime?      @map("started_at")
  finishedAt   DateTime?      @map("finished_at")
  report       AgentReport?
  // Pipeline di vendita (v3.46): lavori, referti e voci di cassetta su una trattativa.
  trattativaId String?        @map("trattativa_id")
  trattativa   Trattativa?    @relation(fields: [trattativaId], references: [id], onDelete: Cascade)

  @@index([status, queuedAt])
  @@index([leadId, agent])
  @@index([bniChapterId])
  @@index([bniMembroId])
  @@index([trattativaId])
  @@map("agent_runs")
}

enum AgentRunStatus {
  IN_CODA
  IN_CORSO
  FATTO
  FALLITO
}

// Il referto: cosa ha trovato l'agente, con le prove e fino a quando vale.
model AgentReport {
  id           String          @id @default(uuid())
  leadId       String?         @map("lead_id")
  lead         Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bniChapterId String?         @map("bni_chapter_id")
  bniChapter   BniChapter?     @relation(fields: [bniChapterId], references: [id], onDelete: Cascade)
  bniMembroId  String?         @map("bni_membro_id")
  bniMembro    BniMembro?      @relation(fields: [bniMembroId], references: [id], onDelete: Cascade)
  agent        String
  runId        String?         @unique @map("run_id")
  run          AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  summary      String // una riga leggibile
  findings     Json // dati strutturati dell'agente
  levers       Json            @default("[]") // leve commerciali: [{servizio, testo, prova}]
  evidence     Json            @default("[]") // prove: [{cosa, fonte, citazione}]
  confidence   AgentConfidence @default(MEDIA)
  collectedAt  DateTime        @default(now()) @map("collected_at")
  validUntil   DateTime        @map("valid_until")
  // Pipeline di vendita (v3.46): lavori, referti e voci di cassetta su una trattativa.
  trattativaId String?         @map("trattativa_id")
  trattativa   Trattativa?     @relation(fields: [trattativaId], references: [id], onDelete: Cascade)

  @@index([leadId, agent, collectedAt])
  @@index([bniChapterId, agent])
  @@index([bniMembroId, agent])
  @@index([trattativaId])
  @@map("agent_reports")
}

enum AgentConfidence {
  ALTA
  MEDIA
  BASSA
}

// La cassetta: tutto ciò che aspetta una decisione di Alessio.
model ApprovalItem {
  id           String         @id @default(uuid())
  leadId       String?        @map("lead_id")
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bniChapterId String?        @map("bni_chapter_id")
  bniChapter   BniChapter?    @relation(fields: [bniChapterId], references: [id], onDelete: Cascade)
  bniMembroId  String?        @map("bni_membro_id")
  bniMembro    BniMembro?     @relation(fields: [bniMembroId], references: [id], onDelete: Cascade)
  kind         String // "FASCICOLO_BASE" (approva la raccolta approfondita), poi bozze di contatto…
  agent        String // chi l'ha proposto
  title        String
  payload      Json
  status       ApprovalStatus @default(IN_ATTESA)
  note         String?
  createdAt    DateTime       @default(now()) @map("created_at")
  decidedAt    DateTime?      @map("decided_at")
  decidedBy    String?        @map("decided_by")
  // Pipeline di vendita (v3.46): lavori, referti e voci di cassetta su una trattativa.
  trattativaId String?        @map("trattativa_id")
  trattativa   Trattativa?    @relation(fields: [trattativaId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([leadId, kind])
  @@index([bniChapterId, kind])
  @@index([bniMembroId, kind])
  @@index([trattativaId])
  @@map("approval_items")
}

enum ApprovalStatus {
  IN_ATTESA
  APPROVATO
  SCARTATO
}

// ==========================================
// PIPELINE DI VENDITA (v3.46) — una sola, per tutte le origini
// ==========================================
// Call di vendita → follow-up o lettera strategica → recall o incarico → exit o nurturing.
// Una trattativa nasce quando c'è una call: dalla squadra (azienda), da BNI (membro),
// da un'opportunità o dal passaparola. Gli agenti V1-V4 preparano, Alessio decide in cassetta.

model Trattativa {
  id      String           @id @default(uuid())
  nome    String // azienda o persona
  origine String // squadra | bni | opportunita | passaparola | sito | cliente
  stadio  TrattativaStadio @default(CALL_FISSATA)

  leadId        String?      @map("lead_id")
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bniMembroId   String?      @map("bni_membro_id")
  bniMembro     BniMembro?   @relation(fields: [bniMembroId], references: [id], onDelete: SetNull)
  opportunitaId String?      @map("opportunita_id")
  opportunita   Opportunita? @relation(fields: [opportunitaId], references: [id], onDelete: SetNull)

  referente String? // con chi si parla
  telefono  String?
  email     String?

  callAt       DateTime? @map("call_at")
  // Trascrizione di Google Meet o appunti di Gemini, incollati da Alessio dopo la call.
  trascrizione String?   @db.Text
  valoreEuro   Int?      @map("valore_euro")

  prossimoPasso     String?   @map("prossimo_passo")
  prossimaData      DateTime? @map("prossima_data")
  recallFatti       Int       @default(0) @map("recall_fatti")
  motivoUscita      String?   @map("motivo_uscita")
  ultimoNurturingAt DateTime? @map("ultimo_nurturing_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  chiusaAt  DateTime? @map("chiusa_at")

  eventi        TrattativaEvento[]
  agentRuns     AgentRun[]
  agentReports  AgentReport[]
  approvalItems ApprovalItem[]

  @@index([stadio, prossimaData])
  @@index([leadId])
  @@map("trattative")
}

enum TrattativaStadio {
  CALL_FISSATA
  CALL_FATTA
  FOLLOW_UP
  LETTERA_INVIATA
  RECALL
  INCARICO
  EXIT
  NURTURING
}

// Il diario della trattativa: ogni cambio di stadio, nota o messaggio approvato.
model TrattativaEvento {
  id           String     @id @default(uuid())
  trattativaId String     @map("trattativa_id")
  trattativa   Trattativa @relation(fields: [trattativaId], references: [id], onDelete: Cascade)
  tipo         String // STADIO | NOTA | MESSAGGIO | CALL
  testo        String?    @db.Text
  da           String? // stadio di partenza
  a            String? // stadio di arrivo
  createdAt    DateTime   @default(now()) @map("created_at")
  createdBy    String?    @map("created_by")

  @@index([trattativaId, createdAt])
  @@map("trattativa_eventi")
}

// ==========================================
// FASE 1 RICERCA (v3.47) — vedi FASE-1-RICERCA.md
// ==========================================

// Un caso studio (PDF caricato da Alessio): un filtro di priorità per la ricerca, valido 6 mesi.
model CasoStudio {
  id              String    @id @default(uuid())
  titolo          String
  pdfNome         String    @map("pdf_nome")
  pdf             Bytes?
  testo           String?   @db.Text
  storia          String?   @db.Text // la versione da 30 secondi
  settore         String?
  aziendaNome     String?   @map("azienda_nome")
  aziendaSito     String?   @map("azienda_sito")
  personaNome     String?   @map("persona_nome")
  personaRuolo    String?   @map("persona_ruolo")
  personaLinkedin String?   @map("persona_linkedin")
  termini         Json      @default("[]") // parole di ricerca per le aziende simili
  terminiSettore  Json      @default("[]") @map("termini_settore") // ricerche più larghe, dopo la nicchia
  provincia       String? // sigla della provincia del cliente (es. CA): esclusa per la nicchia
  stato           String    @default("DA_CONFERMARE") // DA_CONFERMARE | ATTIVO | SCADUTO
  validoFino      DateTime? @map("valido_fino")
  costCents       Float     @default(0) @map("cost_cents")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  confermatoAt    DateTime? @map("confermato_at")

  chiavi ChiaveRicerca[]

  @@map("casi_studio")
}

// Da cosa parte una ricerca: settore, azienda, persona (dai casi studio) o rete di un membro BNI.
model ChiaveRicerca {
  id           String      @id @default(uuid())
  tipo         String // SETTORE | AZIENDA | PERSONA | RETE_MEMBRO
  valore       String
  termini      Json        @default("[]")
  casoStudioId String?     @map("caso_studio_id")
  casoStudio   CasoStudio? @relation(fields: [casoStudioId], references: [id], onDelete: Cascade)
  bniMembroId  String?     @map("bni_membro_id")
  bniMembro    BniMembro?  @relation(fields: [bniMembroId], references: [id], onDelete: Cascade)
  attiva       Boolean     @default(true)
  scadeAt      DateTime?   @map("scade_at")
  zonaIndice   Int         @default(0) @map("zona_indice")
  usi          Int         @default(0)
  trovati      Int         @default(0)
  ultimoUsoAt  DateTime?   @map("ultimo_uso_at")
  esauritaAt   DateTime?   @map("esaurita_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  persone      Persona[]
  ritrovamenti Ritrovamento[]

  @@index([attiva, ultimoUsoAt])
  @@map("chiavi_ricerca")
}

// Una persona (contenitore LinkedIn): sempre collegata alla sua azienda quando si sa qual è.
model Persona {
  id               String         @id @default(uuid())
  nome             String
  ruolo            String?
  aziendaNome      String?        @map("azienda_nome")
  linkedinUrl      String?        @unique @map("linkedin_url")
  localita         String?
  leadId           String?        @map("lead_id")
  lead             Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bniMembroId      String?        @map("bni_membro_id")
  bniMembro        BniMembro?     @relation(fields: [bniMembroId], references: [id], onDelete: SetNull)
  contattoInComune String?        @map("contatto_in_comune")
  chiaveId         String?        @map("chiave_id")
  chiave           ChiaveRicerca? @relation(fields: [chiaveId], references: [id], onDelete: SetNull)
  fonte            String         @default("linkedin") // linkedin | rete_membro | sito
  note             String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  presentazioni BniPresentazione[]
  ritrovamenti  Ritrovamento[]

  @@index([leadId])
  @@index([bniMembroId])
  @@map("persone")
}

// Chi ha trovato cosa: per contare quanto rende una chiave e per filtrare i contenitori.
model Ritrovamento {
  id        String        @id @default(uuid())
  chiaveId  String        @map("chiave_id")
  chiave    ChiaveRicerca @relation(fields: [chiaveId], references: [id], onDelete: Cascade)
  leadId    String?       @map("lead_id")
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  personaId String?       @map("persona_id")
  persona   Persona?      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  canale    String // google | maps | facebook | instagram | linkedin
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([chiaveId])
  @@index([leadId])
  @@map("ritrovamenti")
}

// Le persone da farsi presentare da un membro BNI (dalla sua rete LinkedIn o nominate al 121).
model BniPresentazione {
  id            String    @id @default(uuid())
  membroId      String    @map("membro_id")
  membro        BniMembro @relation(fields: [membroId], references: [id], onDelete: Cascade)
  personaId     String?   @map("persona_id")
  persona       Persona?  @relation(fields: [personaId], references: [id], onDelete: SetNull)
  nome          String
  ruolo         String?
  linkedinUrl   String?   @map("linkedin_url")
  perche        String?
  stato         String    @default("DA_CHIEDERE") // DA_CHIEDERE | CHIESTA | PRESENTATO | NO
  // Motore 121 (v3.52): l'azienda della persona, i punti di contatto e l'imbuto.
  leadId        String?   @map("lead_id")
  puntiContatto Json      @default("[]") @map("punti_contatto")
  forza         Int       @default(0)
  confermata    Boolean? // al 121: "lo conosco bene" (true) o no (false)
  chiestaAt     DateTime? @map("chiesta_at")
  presentatoAt  DateTime? @map("presentato_at")
  incontroAt    DateTime? @map("incontro_at")
  propostaAt    DateTime? @map("proposta_at")
  clienteAt     DateTime? @map("cliente_at")
  esitoNote     String?   @map("esito_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([membroId])
  @@index([leadId])
  @@map("bni_presentazioni")
}

/// Contatti da segnalare a un membro BNI (Motore 121, v3.52): aziende del CRM utili al suo mestiere.
model BniSegnalazione {
  id        String    @id @default(uuid())
  membroId  String    @map("membro_id")
  membro    BniMembro @relation(fields: [membroId], references: [id], onDelete: Cascade)
  leadId    String?   @map("lead_id")
  nome      String
  motivo    String?
  stato     String    @default("DA_DARE") // DA_DARE | DATA | NON_SERVE
  dataAt    DateTime? @map("data_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([membroId])
  @@map("bni_segnalazioni")
}

/// La cerchia stretta (v3.53): chi Alessio conosce davvero, segnato "lo conosco". I membri BNI con
/// cui ha fatto un 121 ne fanno parte da soli (si leggono da bni_membri).
model CerchiaContatto {
  id          String   @id @default(uuid())
  nome        String
  linkedinUrl String?  @map("linkedin_url")
  nota        String?
  rimossoAt   DateTime? @map("rimosso_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([nome])
  @@map("cerchia")
}

/// Un'azienda in lavorazione (v3.53): la fase, la strada e il ponte. 15 il primo mese, 30 dal secondo.
model Lavorazione {
  id            String    @id @default(uuid())
  leadId        String    @unique @map("lead_id")
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fase          String    @default("MAPPATA") // MAPPATA | PONTE_SCELTO | CHIESTA | INCONTRO | PROPOSTA | CLIENTE | PAUSA
  strada        String? // BNI | CERCHIA | DIRETTO | SCALDATO | DA_CONFERMARE | SCALDARE
  decisore      String?
  ponteNome     String?   @map("ponte_nome")
  ponteMembroId String?   @map("ponte_membro_id")
  pontiProvati  Json      @default("[]") @map("ponti_provati")
  tentativi     Int       @default(0)
  chiestaAt     DateTime? @map("chiesta_at")
  promemoriaAt  DateTime? @map("promemoria_at")
  scaldataAt    DateTime? @map("scaldata_at")
  presentatoAt  DateTime? @map("presentato_at")
  incontroAt    DateTime? @map("incontro_at")
  propostaAt    DateTime? @map("proposta_at")
  clienteAt     DateTime? @map("cliente_at")
  pausaFino     DateTime? @map("pausa_fino")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([fase])
  @@map("lavorazioni")
}
